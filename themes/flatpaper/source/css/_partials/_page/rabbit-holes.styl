/* ============== RABBIT HOLES COLLECTION ============== */
.rabbit-holes-intro {
  margin-bottom: 18px;
}

.rabbit-holes-intro h1 {
  margin-top: 12px;
}

.rabbit-holes-intro__copy {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.8;
}

.rabbit-holes-intro__copy p {
  margin: 0;
}

.rabbit-holes-intro__copy p + p {
  margin-top: 8px;
}

.rabbit-hole-card__eyebrow {
  color: var(--color-accent-strong);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.dark-mode .rabbit-hole-card__eyebrow {
  color: var(--color-accent-muted);
}

.rabbit-hole-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 8px;
  color: var(--muted);
  font-size: 12px;
}

.rabbit-hole-card__footer > span,
.rabbit-hole-card__footer > a {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.rabbit-hole-card__footer .lucide {
  width: 14px;
  height: 14px;
}

.rabbit-hole-card__footer > a {
  color: var(--color-accent-strong);
  font-weight: 700;
}

.dark-mode .rabbit-hole-card__footer > a {
  color: var(--color-accent-muted);
}

.rabbit-hole-card.is-coming-soon {
  opacity: 0.66;
}

.rabbit-hole-card.is-coming-soon:hover {
  transform: none;
}

.rabbit-hole-card.is-coming-soon .paper-thumb__img {
  filter: grayscale(0.8) sepia(0.15);
}

.rabbit-holes-patterns {
  margin-top: 18px;
}

.rabbit-holes-patterns h2 {
  margin: 0 0 8px;
  font-size: 18px;
}

.rabbit-holes-patterns p {
  margin: 0 0 12px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.rabbit-holes-patterns a {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--color-accent-strong);
  font-size: 13px;
  font-weight: 700;
}

.dark-mode .rabbit-holes-patterns a {
  color: var(--color-accent-muted);
}

.rabbit-holes-patterns .lucide {
  width: 14px;
  height: 14px;
}
