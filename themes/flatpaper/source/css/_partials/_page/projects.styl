/* ============== PROJECT COLLECTION ============== */
.projects-intro {
  margin-bottom: 22px;
}

.projects-intro h1 {
  margin-top: 12px;
}

.projects-intro__copy {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.8;
}

.projects-intro__copy p {
  margin: 0;
}

.projects-intro__copy p + p {
  margin-top: 8px;
}

.projects-group {
  margin-top: 26px;
}

.projects-group__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 14px;
}

.projects-group__head > div {
  display: flex;
  align-items: center;
  gap: 8px;
}

.projects-group__head h2 {
  margin: 0;
  font-size: 18px;
}

.projects-group__head p {
  max-width: 420px;
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
  text-align: right;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.project-card {
  position: relative;
  overflow: hidden;
  border: 1px dashed var(--line);
  border-radius: 6px;
  background: var(--paper);
  box-shadow: var(--shadow);
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}

.project-card:nth-child(2n) {
  transform: rotate(0.35deg);
}

.project-card:hover {
  transform: translateY(-4px) rotate(0deg);
  box-shadow: var(--shadow);
}

.project-card__visual {
  position: relative;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-bottom: 1px dashed var(--line);
  background:
    unquote('linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 18%, transparent), transparent 65%)'),
    var(--paper-warm);
}

.project-card__visual img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
}

.project-card:hover .project-card__visual img {
  transform: scale(1.025);
}

.project-card__placeholder {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  background:
    unquote('radial-gradient(circle at 20% 28%, color-mix(in srgb, var(--color-accent) 28%, transparent) 0 4px, transparent 5px)'),
    unquote('repeating-linear-gradient(-12deg, transparent 0 18px, color-mix(in srgb, var(--line) 55%, transparent) 19px 20px)');
}

.project-card__placeholder span {
  display: grid;
  place-items: center;
  width: 68px;
  height: 68px;
  border: 2px dashed var(--color-accent);
  border-radius: 18px 12px 20px 14px;
  background: var(--paper);
  color: var(--color-accent-strong);
  font-size: 30px;
  font-weight: 800;
  transform: rotate(-4deg);
}

.project-card__status {
  position: absolute;
  right: 12px;
  bottom: 10px;
  padding: 5px 9px;
  border: 1px solid unquote('color-mix(in srgb, var(--color-accent) 45%, var(--line))');
  border-radius: 999px;
  background: unquote('color-mix(in srgb, var(--paper) 90%, transparent)');
  color: var(--color-accent-strong);
  font-size: 10px;
  font-weight: 800;
  backdrop-filter: blur(8px);
}

.project-card__body {
  display: flex;
  flex-direction: column;
  min-height: 220px;
  padding: 18px;
}

.project-card__eyebrow {
  color: var(--color-accent-strong);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.project-card h3 {
  margin: 5px 0 8px;
  font-size: 18px;
}

.project-card__body > p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.project-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 14px 0 0;
  padding: 0;
  list-style: none;
}

.project-card__tags li {
  padding: 3px 7px;
  border: 1px dashed var(--line);
  border-radius: 4px;
  background: var(--paper-warm);
  color: var(--muted);
  font-size: 10px;
}

.project-card__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: auto;
  padding-top: 18px;
}

.project-action {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 34px;
  padding: 7px 11px;
  border: 1px dashed var(--line);
  border-radius: 5px;
  color: var(--ink);
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
  transition: transform 0.18s ease, border-color 0.18s ease, color 0.18s ease;
}

.project-action:hover {
  border-color: var(--color-accent);
  color: var(--color-accent-strong);
  transform: translateY(-2px);
}

.project-action--primary {
  border-style: solid;
  border-color: var(--color-accent);
  background: var(--color-accent);
  color: #fff;
}

.project-action--primary:hover {
  color: #fff;
}

.project-action .lucide {
  width: 14px;
  height: 14px;
}

.dark-mode .project-card__eyebrow,
.dark-mode .project-card__status {
  color: var(--color-accent-muted);
}

@media (max-width: 760px) {
  .projects-group__head {
    align-items: flex-start;
    flex-direction: column;
    gap: 5px;
  }

  .projects-group__head p {
    text-align: left;
  }

  .projects-grid {
    grid-template-columns: 1fr;
  }

  .project-card:nth-child(2n) {
    transform: none;
  }
}
